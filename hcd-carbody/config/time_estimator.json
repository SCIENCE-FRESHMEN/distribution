{
  // ===== 基础取放货与默认出入口 =====
  // 入库估时中，单次取货动作的默认耗时，单位秒。
  "pickup_time_default": 25.0,
  // 入库/出库估时中，单次放货动作的默认耗时，单位秒。
  "drop_time_default": 25.0,
  // 默认入库口所在列。未命中 dock_map_in 时使用。
  "dock_in_col": 1,
  // 默认出库口所在列。未命中 dock_map_out 时使用。
  // 填写列数最多的巷道对应的最大列数值。
  "dock_out_col": 17,

  // ===== 按入库线/产线配置的出入口位置 =====
  // 入库口位置映射。键为任务/API 使用的入库口标识，值为实际列号和层号。
  // 例如 "L1C17" 的含义就是入库口 L1C17 所在的位置是列17，层1。
  "dock_map_in": {
    "L1C17": { "col": 17, "level": 1 },
    "L2C17": { "col": 17, "level": 2 },
    "L4C1": { "col": 1, "level": 4 }
  },
  // 出库口位置映射。键为任务/API 使用的出库口标识，值为实际列号和层号。
  "dock_map_out": {
    "L1C1": { "col": 1, "level": 1 },
    "L1C17": { "col": 17, "level": 1 },
    "L2C1": { "col": 1, "level": 2 },
    "L2C17": { "col": 17, "level": 2 },
    "L3C17": { "col": 17, "level": 3 }
  },

  // ===== 默认堆垛机物理运动模型 =====
  // 建议基于实际设备测时校准，所有值应大于 0。
  "physics": {
    // 水平方向相邻两列之间的物理距离，单位米。
    "col_scale": 6.0,
    // 垂直方向相邻两层之间的物理距离，单位米。
    "layer_scale": 2.6,
    // 水平方向最大速度，单位米/秒。
    "v_col_max": 2,
    // 垂直方向最大速度，单位米/秒。
    "v_layer_max": 0.5,
    // 水平方向加速度，单位米/秒^2。
    "a_col": 0.4,
    // 垂直方向加速度，单位米/秒^2。
    "a_layer": 0.1
  },

  // ===== 异构巷道物理参数覆盖 =====
  // 键为巷道号，值只填写与全局 physics 不同的字段。
  // 例如若 4 巷道相邻列距实测为 7.2m，可写为 "4": { "col_scale": 7.2 }；
  // 未配置的巷道和字段均使用上方全局 physics，避免未经实测的参数改变仿真结果。
  "physics_by_aisle": {
    "4": { "col_scale": 9.2 }
  }
}
